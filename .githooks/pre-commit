#!/bin/sh
# Prüft Formatierung und Lint mit Ruff, den Umbruch der hart umbrochenen
# Markdown-Dateien und fehlende Migrationen, bevor ein Commit entsteht.
# Aktivierung: git config core.hooksPath .githooks
# pytest läuft bewusst nicht hier, sondern in der CI, damit ein Commit
# nur Sekunden kostet.
set -e

uv run ruff format --check
uv run ruff check
# Nur diese Dateien sind hart auf 80 Zeichen umbrochen (.mdformat.toml);
# beheben mit `uv run mdformat <datei>`. Liste gleich in der CI.
uv run mdformat --check README.md docs/verhalten.md docs/DEPLOYMENT.md
uv run python manage.py makemigrations --check --dry-run
