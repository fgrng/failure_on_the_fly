SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=

# Zeitzone für Eingabe und Anzeige von Zeitpunkten, etwa dem Erhebungszeitraum
# einer Stichprobe. Gespeichert und exportiert wird unabhängig davon in UTC.
TIME_ZONE=Europe/Berlin

# Die Zugangsdaten von Sprachmodell und Transkription liegen an ihren
# Konfigurationen in der Datenbank und nicht mehr in der Umgebung.

# Audio-Transkription ist nur mit vertraglich zugesicherter Zero-Retention aktiv.
TRANSKRIPTION_ZERO_RETENTION=False

# Nur im Deployment nötig (siehe README, Abschnitt "Deployment auf Uberspace").
# CSRF_TRUSTED_ORIGINS=https://isabell.uber.space
# STATIC_ROOT=/home/isabell/html/static
# MEDIA_ROOT=/home/isabell/html/media
# DATABASE_PFAD=/home/isabell/failure_on_the_fly/db.sqlite3
# SECURE_SSL_REDIRECT=True
